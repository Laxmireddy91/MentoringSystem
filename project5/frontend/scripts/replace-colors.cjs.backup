// scripts/replace-colors.cjs
/**
 * Color audit and replacement script (CommonJS).
 * Scans all files under src/ and replaces prohibited colour literals
 * with design-system tokens (CSS variables / Tailwind utilities).
 */
const fs = require('fs');
const path = require('path');

const srcDir = path.resolve(__dirname, '../src');

// Mapping of colour literals to design‑system tokens
const colorMap = {
  // Status colours
  '#10b981': 'var(--status-success)',
  '#34d399': 'var(--status-success)',
  '#f59e0b': 'var(--status-warning)',
  '#f97316': 'var(--status-error)',
  '#ef4444': 'var(--status-error)',
  '#60a5fa': 'var(--status-info)',
  // Role accent colours – replace with CSS var
  '#1e4db7': 'var(--primary-color)',
  '#0f766e': 'var(--primary-color)',
  '#4338ca': 'var(--primary-color)',
  '#7c1d1d': 'var(--primary-color)',
  '#1e3a5f': 'var(--primary-color)',
  '#14532d': 'var(--primary-color)',
  '#92400e': 'var(--primary-color)',
  // Additional UI colour mappings
  '#0F172A': 'var(--primary-dark)',
  '#16233D': 'var(--primary-color)',
  '#1E293B': 'var(--primary-soft-dark)',
  '#F8FAFC': 'var(--primary-soft)',
  '#F1F5F9': 'var(--primary-soft)',
  '#FFFFFF': 'var(--primary-soft)',
  '#C9CEDA': 'var(--primary-soft)',
  '#EFEDE6': 'var(--primary-soft)',
  '#EAB308': 'var(--status-warning)',
  '#64748B': 'var(--primary-soft)',
  '#B58A3D': 'var(--primary-soft)',
  '#2F6350': 'var(--status-success)',
  '#2F4770': 'var(--status-info)',
};

function walkDir(dir, cb) {
  fs.readdirSync(dir).forEach((name) => {
    const full = path.join(dir, name);
    const stat = fs.statSync(full);
    if (stat.isDirectory()) {
      walkDir(full, cb);
    } else if (stat.isFile() && /\.(js|jsx|ts|tsx|css|html)$/.test(full)) {
      cb(full);
    }
  });
}

/**
 * Replace colour literals with their design‑system token equivalents.
 * Uses a regex that only matches whole hex literals, not parts of identifiers,
 * comments or selectors, preventing corruption of Tailwind utilities such as
 * `.focus\:role`.
 */
function replaceColors(filePath) {
  let content = fs.readFileSync(filePath, 'utf8');
  const original = content;

  for (const [oldColor, newVal] of Object.entries(colorMap)) {
    // Escape the leading # for the RegExp literal
    const escaped = oldColor.replace('#', '\\#');
    // Match the hex only when not surrounded by word characters or hyphens
    const safeRegex = new RegExp(`(?<![\\w-])${escaped}(?![\\w-])`, 'gi');
    content = content.replace(safeRegex, newVal);
  }

  if (content !== original) {
    fs.writeFileSync(filePath, content, 'utf8');
    console.log(`Updated ${filePath}`);
  }
}

walkDir(srcDir, replaceColors);
console.log('Color audit completed.');
