NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/smart_mentoring_system
JWT_SECRET=your_jwt_secret_key_minimum_16_characters
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_minimum_16_characters
JWT_REFRESH_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="MentorConnect <noreply@mentorconnect.edu>"
MAX_LOGIN_ATTEMPTS=5
LOCK_TIME_MINUTES=15
LOG_LEVEL=info
