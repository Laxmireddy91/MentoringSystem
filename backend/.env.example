NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/MentoringSystem
JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-another-long-random-secret
